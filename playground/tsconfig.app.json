{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    /* Moves the auto generated tsbuildinfo file to node_modules */
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["vite/client"]
  },
  "include": ["src"],
  "exclude": []
}
