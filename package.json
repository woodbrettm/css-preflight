{
  "$schema": "https://json.schemastore.org/package",
  "name": "workspace-root",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "26.6.6",
    "consola": "3.4.2",
    "oxlint": "1.94.0",
    "stylelint-config-modern": "2.0.1",
    "stylelint-config-standard": "41.0.0",
    "stylelint": "18.0.0",
    "type-fest": "6.0.1",
    "typescript": "7.0.2"
  },
  "scripts": {
    "changeset:add": "changeset",
    "changeset:version": "changeset version",
    "lint:css": "stylelint \"./package/**/*.css\"",
    "lint:js": "oxlint",
    "lint:types": "tsc --noEmit",
    "meta:copy": "node scripts/meta.copy.ts",
    "meta:del": "node scripts/meta.del.ts",
    "tests": "node --test 'tests/**/*.test.ts'"
  }
}
