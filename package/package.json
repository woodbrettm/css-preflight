{
  "$schema": "https://json.schemastore.org/package",
  "name": "css-preflight",
  "version": "2.0.3",
  "type": "module",
  "license": "MIT",
  "description": "CSS browser reset based on Tailwind's preflight, with optional enhancements.",
  "author": {
    "name": "Brett Wood",
    "url": "https://github.com/woodbrettm"
  },
  "bugs": "https://github.com/woodbrettm/css-preflight/issues",
  "homepage": "https://github.com/woodbrettm/css-preflight",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woodbrettm/css-preflight",
    "directory": "package"
  },
  "publishConfig": {
    "provenance": true
  },
  "keywords": [
    "base-styles",
    "browser-reset",
    "css",
    "css-reset",
    "modern-css",
    "modern-reset",
    "normalize",
    "normalize-css",
    "preflight",
    "reset",
    "reset-css",
    "stylesheet",
    "tailwind",
    "tailwind-preflight",
    "tailwindcss",
    "vanilla-css"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./styles/preflight.css"
    },
    "./preflight.css": "./styles/preflight.css",
    "./preflight-fonts.css": "./styles/preflight-fonts.css",
    "./font-mono.css": "./styles/font-mono.css",
    "./font-sans-serif.css": "./styles/font-sans-serif.css",
    "./font-serif.css": "./styles/font-serif.css",
    "./mono-elements.css": "./styles/mono-elements.css",
    "./rem-same-px.css": "./styles/rem-same-px.css",
    "./smooth-scroll.css": "./styles/smooth-scroll.css",
    "./text-wrap-balance.css": "./styles/text-wrap-balance.css"
  },
  "files": [
    "LICENSE.md",
    "LICENSE_TAILWIND.md",
    "styles",
    "package.json",
    "README.md",
    "index.d.ts"
  ]
}
